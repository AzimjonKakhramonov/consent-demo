# Скопируйте этот файл в .env. Значения заполняет владелец локально.
# Токен вашего бота из BotFather. Не публикуйте его и не вставляйте в URL браузера.
TELEGRAM_BOT_TOKEN=
# ID вашего личного чата с ботом. Сначала самостоятельно начните диалог с ботом.
# Используйте уже известный вам chat_id; не публикуйте его.
TELEGRAM_CHAT_ID=
# Необязательно: пустое поле означает порт 3000. После изменения перезапустите сервер.
PORT=
